<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="UTF-8">
{{#if base_url}}<base href="{{ base_url }}">{{/if}}
<title>{{#if (eq path "index.md")}}Virling docs{{else}}{{ chapter_title }} · Virling docs{{/if}}</title>
<meta name="description" content="{{ description }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="{{ resource "favicon.svg" }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ resource "highlight.css" }}">
{{#each additional_css}}
<link rel="stylesheet" href="{{ resource this }}">
{{/each}}
<script defer src="https://app.virling.com/v.js" data-site="virling.com" data-respect-gpc></script>
<script>
var path_to_root = "{{ path_to_root }}";
{{#if search_js}}
window.virlingSearch = { index: "{{ resource "searchindex.js" }}", lunr: "{{ resource "elasticlunr.min.js" }}" };
{{/if}}
(function () {
  var t = null;
  try { t = localStorage.getItem("virling-docs-theme"); } catch (e) {}
  if (t !== "dark" && t !== "light") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  document.documentElement.className = t;
})();
</script>
</head>
<body class="{{#if (eq path "index.md")}}home{{else}}article{{/if}}">
<a class="skip" href="#content">Skip to content</a>
<header class="hd">
  <button class="ibtn only-m" type="button" data-drawer-open aria-label="Open navigation" aria-controls="sidewrap" aria-expanded="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
  <div class="hd-brand">
    <a class="brand" href="{{ path_to_root }}index.html"><svg width="24" height="24" viewBox="0 0 48 48" aria-hidden="true"><circle cx="8" cy="9" r="3.4" fill="currentColor"/><circle cx="13.3" cy="19" r="3.4" fill="currentColor"/><circle cx="18.6" cy="29" r="3.4" fill="currentColor"/><path d="M24 39 L40 8" stroke="currentColor" stroke-width="5" stroke-linecap="round" fill="none"/><circle cx="24" cy="39" r="6" fill="#E8471C"/></svg><b>virling</b></a>
    <span class="docs-tag">Docs</span>
  </div>
  <button class="sbox only-d" type="button" data-search-open><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg><span class="ph">Search docs</span><span class="kbd" data-mod-k>Ctrl K</span></button>
  <span class="grow"></span>
  <div class="hd-r">
    <span class="ver only-d">v0.1.0</span>
    <a class="hd-link only-d" href="https://virling.com">virling.com<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
    <a class="hd-link only-d" href="https://github.com/virling/virling"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>GitHub</a>
    <span class="vsep only-d"></span>
    <button class="ibtn only-m" type="button" data-search-open aria-label="Search"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></button>
    <button class="ibtn" type="button" data-theme-toggle aria-label="Switch color theme"><svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg><svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
  </div>
</header>

<div class="shell">
  <div class="scrim" data-drawer-close hidden></div>
  <div class="sidewrap" id="sidewrap">
    <div class="drawer-h">
      <a class="brand" href="{{ path_to_root }}index.html"><svg width="24" height="24" viewBox="0 0 48 48" aria-hidden="true"><circle cx="8" cy="9" r="3.4" fill="currentColor"/><circle cx="13.3" cy="19" r="3.4" fill="currentColor"/><circle cx="18.6" cy="29" r="3.4" fill="currentColor"/><path d="M24 39 L40 8" stroke="currentColor" stroke-width="5" stroke-linecap="round" fill="none"/><circle cx="24" cy="39" r="6" fill="#E8471C"/></svg><b>virling</b></a>
      <span class="docs-tag">Docs</span><span class="grow"></span>
      <button class="ibtn" type="button" data-drawer-close aria-label="Close navigation"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>
    <button class="sbox" type="button" data-search-open><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg><span class="ph">Search docs</span></button>
    <nav class="side" id="side" aria-label="Docs">{{#toc}}{{/toc}}</nav>
    <script>
    (function () {
      var here = location.pathname.replace(/\/index\.html$|\.html$/, "").replace(/\/$/, "") || "/";
      document.querySelectorAll("#side a[href]").forEach(function (a) {
        var href = a.getAttribute("href");
        if (!/^[a-z]+:|^\//.test(href) && !a.closest("[data-abs]")) a.setAttribute("href", path_to_root + href);
        var p = a.pathname.replace(/\/index\.html$|\.html$/, "").replace(/\/$/, "") || "/";
        if (p === here) { a.classList.add("on"); a.setAttribute("aria-current", "page"); }
      });
    })();
    </script>
    <div class="drawer-f">
      <a class="hd-link" href="https://virling.com">virling.com<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
      <a class="hd-link" href="https://github.com/virling/virling">GitHub</a>
      <span class="grow"></span>
      <span class="ver">v0.1.0</span>
    </div>
  </div>

{{#if (eq path "index.md")}}
  <main class="home-main" id="content">
{{{ content }}}
    <footer class="wrap hft"><span>AGPL-3.0</span><a href="https://github.com/virling/virling">GitHub</a><a href="https://virling.com">virling.com</a><a href="https://github.com/virling/virling/blob/main/CHANGELOG.md">Changelog</a><span class="grow"></span><span>Built by Stacklance Infotech LLP</span></footer>
  </main>
{{else}}
  <main class="main" id="content">
    <article class="doc">
      <nav class="crumbs" aria-label="Breadcrumb" data-crumbs></nav>
{{{ content }}}
      <div class="help" data-help>
        <span class="help-ask"><b>Was this page helpful?</b><button class="pill" type="button" data-help-yes>Yes</button><a class="pill" data-issue href="https://github.com/virling/virling/issues/new?template=docs.yml" target="_blank" rel="noopener">No</a></span>
        <span class="thanks" hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>Thanks for letting us know.</span>
        <span class="grow"></span>
        {{#if git_repository_edit_url}}<a class="edit" href="{{ git_repository_edit_url }}"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13 7l4 4"/></svg>Edit this page on GitHub</a>{{/if}}
      </div>
      <nav class="pn" aria-label="Previous and next page">
        {{#if previous}}<a rel="prev" href="{{ path_to_root }}{{ previous.link }}"><small>Previous</small><b><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>{{ previous.name }}</b></a>{{else}}<span></span>{{/if}}
        {{#if next}}<a class="r" rel="next" href="{{ path_to_root }}{{ next.link }}"><small>Next</small><b>{{ next.name }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></b></a>{{/if}}
      </nav>
      <footer class="ft"><span>AGPL-3.0</span><a href="https://github.com/virling/virling">GitHub</a><a href="https://virling.com">virling.com</a><span>Built by Stacklance Infotech LLP</span></footer>
    </article>
    <aside class="toc" aria-label="On this page" hidden>
      <h6>On this page</h6>
      <div class="toc-l"></div>
      <div class="toc-x">
        {{#if git_repository_edit_url}}<a href="{{ git_repository_edit_url }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13 7l4 4"/></svg>Edit this page</a>{{/if}}
        <a data-issue href="https://github.com/virling/virling/issues/new?template=docs.yml" target="_blank" rel="noopener"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="1.5"/></svg>Report an issue</a>
        <a href="#"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>Back to top</a>
      </div>
    </aside>
  </main>
{{/if}}
</div>

{{#if search_enabled}}
<div class="search" hidden>
  <div class="scrim" data-search-close></div>
  <div class="sm" role="dialog" aria-modal="true" aria-label="Search the docs">
    <div class="sm-in">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <input class="sm-q" type="search" placeholder="Search the docs" aria-label="Search the docs" aria-controls="sm-body" autocomplete="off" spellcheck="false">
      <button class="kbd sm-esc" type="button" data-search-close>esc</button>
    </div>
    <div class="sm-meta" aria-live="polite"></div>
    <div class="sm-body" id="sm-body" role="listbox"></div>
    <div class="sm-f"><span><span class="kbd">&#8593;</span><span class="kbd">&#8595;</span>to move</span><span><span class="kbd">&#8629;</span>to open</span><span><span class="kbd">esc</span>to close</span><span class="grow"></span><span><span class="kbd">/</span>or<span class="kbd" data-mod-k>Ctrl K</span>anywhere</span></div>
  </div>
</div>
{{/if}}

{{#if live_reload_endpoint}}
<script>
(function () {
  var ws = new WebSocket((location.protocol === "https:" ? "wss:" : "ws:") + "//" + location.host + "/{{{ live_reload_endpoint }}}");
  ws.onmessage = function (e) { if (e.data === "reload") { ws.close(); location.reload(); } };
  window.onbeforeunload = function () { ws.close(); };
})();
</script>
{{/if}}
<script src="{{ resource "highlight.js" }}"></script>
{{#each additional_js}}
<script src="{{ resource this }}"></script>
{{/each}}
</body>
</html>
